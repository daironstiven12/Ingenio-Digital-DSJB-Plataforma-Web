# ===== /api/contact — variables de servidor (sin NEXT_PUBLIC_) =====
# Copiar a .env.local y rellenar. .env*.local está cubierto por .gitignore
# (.env*); nunca commitear claves.

# --- Correo (Resend por fetch, sin SDK) ---
# Clave del panel de Resend (https://resend.com/api-keys).
RESEND_API_KEY=
# Destinatario del equipo. Con el remitente de PRUEBAS de Resend
# (onboarding@resend.dev) SOLO se puede enviar al correo con el que se
# registró la cuenta de Resend. Para enviar a otros destinatarios hay que
# verificar el dominio del remitente en Resend.
CONTACT_TO_EMAIL=
# Remitente. Por defecto: "Ingenio Digital <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=

# --- WhatsApp (proveedor intercambiable; por defecto ninguno) ---
# "none" (por defecto) = no envía por WhatsApp. "callmebot" = servicio
# gratuito NO OFICIAL, "solo uso personal", solo envía AL NÚMERO que lo
# activó (enviar un WhatsApp desde ese número al bot siguiendo las
# instrucciones de callmebot y guardar el apikey aquí). Para un canal de
# negocio real: Cloud API de WhatsApp Business Platform (Meta) — ver
# comentarios en lib/notifiers/index.js y lib/notifiers/callmebot.js.
WHATSAPP_PROVIDER=none
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
